# Copy to .env (never commit .env). Every value has a safe default for development.
APP_ENV=development
PORT=8000
DATABASE_URL=file:./tasks.db
# Only for a hosted libSQL database (Turso, Bonus 19)
DATABASE_AUTH_TOKEN=
# Used to sign tokens. Production refuses the default; make one with: openssl rand -hex 32
JWT_SECRET=change-me
